# Public VAPID key; the same value is also exposed to clients through Supabase Vault.
BUFFALO_PUSH_VAPID_PUBLIC_KEY=replace-with-public-vapid-key
# Never commit the real private key or worker secret.
BUFFALO_PUSH_VAPID_PRIVATE_KEY=replace-with-private-vapid-key
BUFFALO_PUSH_VAPID_SUBJECT=mailto:replace-with-contact@example.com
BUFFALO_PUSH_WORKER_SECRET=replace-with-random-worker-secret
